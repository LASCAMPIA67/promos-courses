{
  "name": "promos-courses-appli",
  "private": true,
  "version": "0.12.0",
  "description": "Appli web (iPhone) : liste de courses commune et promos de nos magasins.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "qualite": "lhci autorun",
    "e2e": "firebase emulators:exec --config ../firebase/firebase.json --only auth,firestore --project demo-promos-courses \"playwright test\"",
    "captures": "CAPTURES=1 firebase emulators:exec --config ../firebase/firebase.json --only auth,firestore --project demo-promos-courses \"playwright test e2e/captures.spec.js\""
  },
  "dependencies": {
    "@tesseract.js-data/fra": "^1.0.0",
    "firebase": "^13.1.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}

{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --host 127.0.0.1 --port 4174 --strictPort",
      "startServerReadyPattern": "4174",
      "url": ["http://127.0.0.1:4174/promos-courses/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse"
    }
  }
}

rules_version = '2';

// Règles d'accès à la base Firestore du projet « promos-courses ».
// À copier dans la console Firebase : Firestore → onglet « Règles » → « Publier ».
// Explications : docs/liste-commune.md
service cloud.firestore {
  match /databases/{database}/documents {

    // Seuls les deux comptes du foyer ont accès aux données (identifiants Firebase, non personnels).
    function estDuFoyer() {
      return request.auth != null
        && request.auth.uid in ['ElRK8CEajUMQmtajHXv5qZVVT6G2', 'XABqepPEkHXg8gBon5ljE5XEXOD3'];
    }

    // Un texte facultatif de longueur raisonnable.
    function texteOuAbsent(donnees, champ, longueurMax) {
      return !(champ in donnees) || (donnees[champ] is string && donnees[champ].size() <= longueurMax);
    }

    // Forme d'un article de la liste de courses.
    function articleValide(a) {
      return a.keys().hasAll(['nom', 'achete', 'ajoute_par', 'cree_le', 'modifie_le'])
        && a.keys().hasOnly(['nom', 'quantite', 'note', 'achete', 'ajoute_par', 'cree_le', 'modifie_le'])
        && a.nom is string && a.nom.size() > 0 && a.nom.size() <= 100
        && texteOuAbsent(a, 'quantite', 30)
        && texteOuAbsent(a, 'note', 200)
        && a.achete is bool
        && a.ajoute_par is string
        && a.cree_le is timestamp
        && a.modifie_le == request.time;
    }

    // La liste de courses commune : un document par article.
    match /articles/{article} {
      allow read, delete: if estDuFoyer();
      allow create: if estDuFoyer()
        && articleValide(request.resource.data)
        && request.resource.data.ajoute_par == request.auth.uid
        && request.resource.data.cree_le == request.time;
      // On ne peut pas changer qui a ajouté l'article, ni quand.
      allow update: if estDuFoyer()
        && articleValide(request.resource.data)
        && request.resource.data.ajoute_par == resource.data.ajoute_par
        && request.resource.data.cree_le == resource.data.cree_le;
    }

    // Le prénom et la couleur de chacun, pour savoir qui a ajouté quel article (une fiche par
    // compte, que seul son propriétaire peut écrire).
    function membreValide(m) {
      return m.keys().hasAll(['prenom', 'couleur'])
        && m.keys().hasOnly(['prenom', 'couleur'])
        && m.prenom is string && m.prenom.size() > 0 && m.prenom.size() <= 30
        && m.couleur in ['vert', 'bleu', 'violet', 'rose', 'orange', 'jaune'];
    }

    match /membres/{membre} {
      allow read: if estDuFoyer();
      allow create, update: if estDuFoyer() && membre == request.auth.uid && membreValide(request.resource.data);
      allow delete: if estDuFoyer() && membre == request.auth.uid;
    }

    // Les tickets de caisse : une fiche par ticket (magasin, date, montant…) et son fichier (photo
    // allégée ou PDF, 5 Mio au plus) découpé en morceaux de moins de 1 Mio, la limite d'un document.
    function ticketValide(t) {
      return t.keys().hasAll(['magasin', 'date_achat', 'type', 'taille', 'morceaux', 'ajoute_par', 'cree_le'])
        && t.keys().hasOnly(['magasin', 'date_achat', 'montant', 'note', 'type', 'taille', 'morceaux', 'ajoute_par', 'cree_le'])
        && t.magasin in ['leclerc', 'lidl', 'autre']
        && t.date_achat is string && t.date_achat.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && (!('montant' in t) || (t.montant is number && t.montant >= 0 && t.montant <= 10000))
        && texteOuAbsent(t, 'note', 200)
        && t.type in ['image/jpeg', 'application/pdf']
        && t.taille is int && t.taille > 0 && t.taille <= 5242880
        && t.morceaux is int && t.morceaux >= 1 && t.morceaux <= 6
        && t.ajoute_par is string
        && t.cree_le is timestamp;
    }

    match /tickets/{ticket} {
      allow read, delete: if estDuFoyer();
      allow create: if estDuFoyer()
        && ticketValide(request.resource.data)
        && request.resource.data.ajoute_par == request.auth.uid
        && request.resource.data.cree_le == request.time;
      // Seuls le magasin, la date, le montant et la note peuvent être corrigés ; jamais le fichier.
      allow update: if estDuFoyer()
        && ticketValide(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['magasin', 'date_achat', 'montant', 'note']);

      // Les morceaux du fichier : numérotés 0, 1, 2…, ajoutés avec leur fiche, jamais modifiés.
      match /morceaux/{morceau} {
        allow read, delete: if estDuFoyer();
        allow create: if estDuFoyer()
          && morceau.matches('[0-5]')
          && int(morceau) < getAfter(/databases/$(database)/documents/tickets/$(ticket)).data.morceaux
          && request.resource.data.keys().hasOnly(['donnees'])
          && request.resource.data.donnees is bytes
          && request.resource.data.donnees.size() > 0
          && request.resource.data.donnees.size() <= 900000;
      }
    }

    // Réglages communs du foyer (cartes de fidélité, magasins préférés…).
    match /reglages/{reglage} {
      allow read, write: if estDuFoyer();
    }

    // Tout le reste est fermé.
  }
}

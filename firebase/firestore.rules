rules_version = '2';

// Règles d'accès à la base Firestore du projet « promos-courses ».
// À copier dans la console Firebase : Firestore → onglet « Règles » → « Publier ».
// Explications : docs/liste-commune.md
service cloud.firestore {
  match /databases/{database}/documents {

    // Seuls les deux comptes du foyer ont accès aux données (identifiants Firebase, non personnels).
    function estDuFoyer() {
      return request.auth != null
        && request.auth.uid in ['ElRK8CEajUMQmtajHXv5qZVVT6G2', 'XABqepPEkHXg8gBon5ljE5XEXOD3'];
    }

    // Un texte facultatif de longueur raisonnable.
    function texteOuAbsent(donnees, champ, longueurMax) {
      return !(champ in donnees) || (donnees[champ] is string && donnees[champ].size() <= longueurMax);
    }

    // Forme d'un article de la liste de courses.
    function articleValide(a) {
      return a.keys().hasAll(['nom', 'achete', 'ajoute_par', 'cree_le', 'modifie_le'])
        && a.keys().hasOnly(['nom', 'quantite', 'note', 'achete', 'ajoute_par', 'cree_le', 'modifie_le'])
        && a.nom is string && a.nom.size() > 0 && a.nom.size() <= 100
        && texteOuAbsent(a, 'quantite', 30)
        && texteOuAbsent(a, 'note', 200)
        && a.achete is bool
        && a.ajoute_par is string
        && a.cree_le is timestamp
        && a.modifie_le == request.time;
    }

    // La liste de courses commune : un document par article.
    match /articles/{article} {
      allow read, delete: if estDuFoyer();
      allow create: if estDuFoyer()
        && articleValide(request.resource.data)
        && request.resource.data.ajoute_par == request.auth.uid
        && request.resource.data.cree_le == request.time;
      // On ne peut pas changer qui a ajouté l'article, ni quand.
      allow update: if estDuFoyer()
        && articleValide(request.resource.data)
        && request.resource.data.ajoute_par == resource.data.ajoute_par
        && request.resource.data.cree_le == resource.data.cree_le;
    }

    // Réglages communs du foyer (cartes de fidélité, magasins préférés…).
    match /reglages/{reglage} {
      allow read, write: if estDuFoyer();
    }

    // Tout le reste est fermé.
  }
}
